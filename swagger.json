{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Get all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "A list of all books",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "example": "6aefa3f4f9701e3ee77a691f"
                      },
                      "id": {
                        "type": "string",
                        "example": "b1"
                      },
                      "author": {
                        "type": "string",
                        "example": "Maya Rivera"
                      },
                      "title": {
                        "type": "string",
                        "example": "Patterns of Light"
                      },
                      "publicationDate": {
                        "type": "string",
                        "example": "2021-08-17"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Get one book by id",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The custom id of the book",
            "example": "b1"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching book",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": {
                      "type": "string",
                      "example": "6aefa3f4f9701e3ee77a691f"
                    },
                    "id": {
                      "type": "string",
                      "example": "b1"
                    },
                    "author": {
                      "type": "string",
                      "example": "Maya Rivera"
                    },
                    "title": {
                      "type": "string",
                      "example": "Patterns of Light"
                    },
                    "publicationDate": {
                      "type": "string",
                      "example": "2021-08-17"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No book has that id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Book not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "A list of all authors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "example": "6aefa3f4f9701e3ee77a6920"
                      },
                      "id": {
                        "type": "string",
                        "example": "a1"
                      },
                      "name": {
                        "type": "string",
                        "example": "Frank Herbert"
                      },
                      "birthYear": {
                        "type": "integer",
                        "example": 1920
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new author",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "a4"
                  },
                  "name": {
                    "type": "string",
                    "example": "Ursula K. Le Guin"
                  },
                  "birthYear": {
                    "type": "integer",
                    "example": 1929
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The author was created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": {
                      "type": "string",
                      "example": "6aefa3f4f9701e3ee77a6921"
                    },
                    "id": {
                      "type": "string",
                      "example": "a4"
                    },
                    "name": {
                      "type": "string",
                      "example": "Ursula K. Le Guin"
                    },
                    "birthYear": {
                      "type": "integer",
                      "example": 1929
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing field, wrong type, or empty body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "name is required"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "An author with that id already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Author id already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Get one author by id",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The custom id of the author",
            "example": "a1"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching author",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": {
                      "type": "string",
                      "example": "6aefa3f4f9701e3ee77a6920"
                    },
                    "id": {
                      "type": "string",
                      "example": "a1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Frank Herbert"
                    },
                    "birthYear": {
                      "type": "integer",
                      "example": 1920
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No author has that id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Author not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update an author by id",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The custom id of the author",
            "example": "a1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Frank Herbert"
                  },
                  "birthYear": {
                    "type": "integer",
                    "example": 1920
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated author",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "a1"
                    },
                    "name": {
                      "type": "string",
                      "example": "Frank Herbert"
                    },
                    "birthYear": {
                      "type": "integer",
                      "example": 1920
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing field, wrong type, empty body, or id in the body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "id cannot be changed in the body"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No author has that id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Author not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an author by id",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The custom id of the author",
            "example": "a5"
          }
        ],
        "responses": {
          "204": {
            "description": "The author was deleted (no body)"
          },
          "404": {
            "description": "No author has that id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Author not found"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "The author still has books",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Author still has books"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}